# --- Telegram (user client) ---
# https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Filled by `pnpm login`. Full access to your account: keep secret.
TG_SESSION=
TG_CHANNEL=hardcoretrading

# --- Bybit ---
# demo: real prices, virtual balance (recommended first) | testnet | mainnet
BYBIT_ENV=demo
# API key: Contract trading only, NO withdrawal permission, bound to your server IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# true = only log what would be done
DRY_RUN=true
DRY_RUN_EQUITY=1000

# --- Execution rules (found by `pnpm optimize` on a year of the channel) ---
# Levels are measured from the zone's worst edge, where price usually is when a post appears.
# Enter with a limit 75% into the zone, stop at 0.75× the channel's distance, target at 3×,
# move stop to entry halfway to target. As posted: ENTRY_FRAC=0 TP_MULT=1 SL_MULT=1 BREAKEVEN_AT=0
ENTRY_FRAC=0.75
TP_MULT=3
SL_MULT=0.75
BREAKEVEN_AT=0.5

# --- Risk ---
RISK_PER_TRADE_PCT=1
MAX_LEVERAGE=20
LIQ_BUFFER=1.5
MIN_RR=0
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=5
MAX_MARGIN_PCT=25
ENTRY_TIMEOUT_MIN=240
MAX_SIGNAL_AGE_SEC=180
# e.g. краткосрок,среднесрок (empty = all)
TRADE_TYPES=
# e.g. FF,LINEA
COIN_BLACKLIST=

# --- Notifications to you (optional): bot from @BotFather, your chat id from @userinfobot ---
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=
